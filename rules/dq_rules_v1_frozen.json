{
  "version": "V1-FROZEN",
  "frozen_at": "2026-09-17",
  "basis": "GB/T 36344-2018 六指标; GB/T 35639-2017 地址组分; 错漏分级思想参照 GB/T 18316/24356",
  "calc_convention": "RulePass = A/B (A=满足规则的数据元素/记录数, B=适用元素/记录数); 维度得分=加权平均; Coverage=已评价规则数/计划规则数; 无检测证据的维度记 N/A 不计分",
  "severity_levels": {
    "C0": "致命: 文件不可解析/坐标系错误/主键系统性问题",
    "C1": "关键: 主键缺失重复/明显错误坐标/跨区钉死 (Hard Gate)",
    "C2": "主要: 区县不一致/定位组分缺失/POI不可靠",
    "C3": "一般: 格式/命名/非关键字段"
  },
  "rules": [
    {"id":"R001","dim":"规范性","sub":"数据标准符合","field":"店编码","rule":"非空且为字符串编码","A":"符合记录数","B":"总记录数","threshold":1.0,"sev":"C1","hard_gate":true},
    {"id":"R002","dim":"规范性","sub":"数据标准符合","field":"店名","rule":"非空且长度>=2","A":"符合记录数","B":"总记录数","threshold":1.0,"sev":"C2","hard_gate":false},
    {"id":"R003","dim":"规范性","sub":"权威参考数据","field":"province","rule":"合法值=安徽省","A":"符合记录数","B":"总记录数","threshold":1.0,"sev":"C1","hard_gate":true},
    {"id":"R004","dim":"规范性","sub":"权威参考数据","field":"city","rule":"合法值=芜湖市","A":"符合记录数","B":"总记录数","threshold":1.0,"sev":"C1","hard_gate":true},
    {"id":"R005","dim":"规范性","sub":"权威参考数据","field":"区县名称/district","rule":"district∈民政部码表芜湖合法区县集合(Xzqh20251231)","A":"符合记录数","B":"总记录数","threshold":1.0,"sev":"C1","hard_gate":true},
    {"id":"R006","dim":"规范性","sub":"数据标准符合","field":"channel","rule":"∈约定渠道码表","A":"符合记录数","B":"总记录数","threshold":0.98,"sev":"C3","hard_gate":false},
    {"id":"R007","dim":"规范性","sub":"数据标准符合","field":"OTM等级","rule":"∈约定值域{A,B,C,PA,PB,PC}","A":"符合记录数","B":"适用(非空)记录数","threshold":0.98,"sev":"C3","hard_gate":false},
    {"id":"R008","dim":"规范性","sub":"数据标准符合","field":"lng","rule":"数值型且芜湖经度范围[117.5,119.0]","A":"符合记录数","B":"总记录数","threshold":1.0,"sev":"C1","hard_gate":true},
    {"id":"R009","dim":"规范性","sub":"数据标准符合","field":"lat","rule":"数值型且芜湖纬度范围[30.5,31.8]","A":"符合记录数","B":"总记录数","threshold":1.0,"sev":"C1","hard_gate":true},
    {"id":"R010","dim":"规范性","sub":"地址结构(GB/T35639 §6.2)","field":"customer_address","rule":"地址满足定位结构: 行政区划名+(街路巷名|院门楼址)","A":"满足记录数","B":"总记录数","threshold":0.98,"sev":"C2","hard_gate":false},
    {"id":"R011","dim":"完整性","sub":"元素完整","field":"店编码","rule":"非空非占位","A":"已赋值记录数","B":"总记录数","threshold":1.0,"sev":"C1","hard_gate":true},
    {"id":"R012","dim":"完整性","sub":"元素完整","field":"店名","rule":"非空非占位","A":"已赋值记录数","B":"总记录数","threshold":1.0,"sev":"C2","hard_gate":false},
    {"id":"R013","dim":"完整性","sub":"元素完整","field":"区县名称","rule":"非空非占位(区分'0'/'--'/'未知')","A":"已赋值记录数","B":"总记录数","threshold":0.995,"sev":"C2","hard_gate":false},
    {"id":"R014","dim":"完整性","sub":"元素完整","field":"地址","rule":"非空非占位","A":"已赋值记录数","B":"总记录数","threshold":0.995,"sev":"C2","hard_gate":false},
    {"id":"R015","dim":"完整性","sub":"元素完整","field":"经纬度","rule":"非空且≠(0,0)","A":"已赋值记录数","B":"总记录数","threshold":1.0,"sev":"C1","hard_gate":true},
    {"id":"R016","dim":"完整性","sub":"元素完整","field":"channel/OTM等级","rule":"必填字段有效赋值率","A":"已赋值元素数","B":"应赋值元素数","threshold":0.95,"sev":"C3","hard_gate":false},
    {"id":"R017","dim":"完整性","sub":"地址组分(GB/T35639三级指标)","field":"customer_address","rule":"具备可定位组分(街路巷名或院门/楼址, §6.2)","A":"具备记录数","B":"适用地址记录数","threshold":0.98,"sev":"C2","hard_gate":false},
    {"id":"R018","dim":"准确性","sub":"内容正确(位置)","field":"区县×坐标","rule":"填报区县=腾讯坐标反解adcode","A":"一致记录数","B":"成功反解记录数","threshold":0.98,"sev":"C2","hard_gate":true,"note":"命名: 填报区县-坐标空间位置一致率; 腾讯非绝对真值, 以高德交叉+缓冲带修正"},
    {"id":"R019","dim":"准确性","sub":"交叉验证","field":"坐标","rule":"高德反解adcode与填报一致(独立第二源)","A":"一致记录数","B":"成功反解记录数","threshold":0.98,"sev":"C2","hard_gate":false},
    {"id":"R020","dim":"准确性","sub":"POI空间对象匹配","field":"店名+坐标","rule":"poi_association命中且reliability>=0.8","A":"达标关联记录数","B":"总记录数","threshold":0.80,"sev":"C3","hard_gate":false},
    {"id":"R021","dim":"准确性","sub":"POI空间对象匹配","field":"POI官方adcode","rule":"命中记录中POI官方adcode=填报区","A":"一致记录数","B":"命中记录数","threshold":0.95,"sev":"C2","hard_gate":false},
    {"id":"R022","dim":"准确性","sub":"唯一性","field":"店编码","rule":"全表唯一","A":"唯一编码记录数","B":"总记录数","threshold":1.0,"sev":"C1","hard_gate":true},
    {"id":"R023","dim":"准确性","sub":"异常坐标复用","field":"lng/lat","rule":"不同店编码+不同地址+字节级同坐标+跨区县 → 异常复用","A":"—","B":"—","threshold":"异常复用记录数=0","sev":"C1","hard_gate":true,"metric":"负向: PinnedRate=异常复用店数/有坐标店数"},
    {"id":"R024","dim":"准确性","sub":"紧邻风险","field":"lng/lat","rule":"50米紧邻(不同店编码不同地址)","A":"—","B":"—","threshold":"风险信号, 不计分","sev":"C3","hard_gate":false},
    {"id":"R025","dim":"一致性","sub":"相同数据一致","field":"坐标","rule":"腾讯反解adcode=高德反解adcode","A":"一致记录数","B":"双源成功记录数","threshold":0.99,"sev":"C2","hard_gate":false},
    {"id":"R026","dim":"一致性","sub":"关联数据一致","field":"POI×坐标","rule":"POI官方adcode=坐标反解adcode(命中内)","A":"一致记录数","B":"双成功记录数","threshold":0.95,"sev":"C2","hard_gate":false},
    {"id":"R027","dim":"一致性","sub":"层级逻辑","field":"province×city×district","rule":"区县代码前4位=城市代码, 城市=芜湖","A":"符合记录数","B":"总记录数","threshold":1.0,"sev":"C1","hard_gate":false},
    {"id":"R028","dim":"时效性","sub":"现势性(证据受限)","field":"POI invalid_status","rule":"=-1 的比例作为现势性风险证据","A":"—","B":"—","threshold":"仅报告风险, 不判合格","sev":"C2","hard_gate":false,"note":"Coverage不足, 指标级记 N/A"},
    {"id":"R029","dim":"可访问性","sub":"可访问","field":"文件","rule":"xlsx可解析/UTF-8可读/字段可访问","A":"可访问元素","B":"应可访问元素","threshold":1.0,"sev":"C0","hard_gate":true,"note":"文件级检查"},
    {"id":"R030","dim":"完整性","sub":"记录完整","field":"整行","rule":"全部必填字段有效的记录占比","A":"完整记录数","B":"总记录数","threshold":0.98,"sev":"C2","hard_gate":false},
    {"id":"R031","dim":"一致性","sub":"跨源裁决","field":"不一致记录","rule":"腾讯≠填报时, POI高可信且官方adcode=填报 → 裁决坐标错(非字段错)","A":"—","B":"—","threshold":"裁决过程留痕","sev":"C2","hard_gate":false}
  ],
  "hard_gates": ["R001","R003","R004","R005","R008","R009","R011","R015","R022","R023"],
  "batch_verdict": "PASS = 全部HardGate通过 ∧ 准确性≥98% ∧ 完整性≥98% ∧ 一致性≥99% ∧ 无系统性缺陷; 有条件合格 = 无致命/系统性问题但少量指标未达阈值且有整改措施; 不合格 = HardGate失败或系统性缺陷。时效性/可访问性证据不足记 N/A。",
  "methodology_note": "规则在评估报告生成前冻结。既往探索性运行先于规则冻结, 以 GB/T 2828.1 抽样(n=80)验证检测器误报/漏报作为方法学补偿。"
}
